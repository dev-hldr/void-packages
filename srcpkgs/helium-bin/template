# Template file for 'helium-bin'
pkgname=helium-bin
version=0.18.2.1
revision=1
archs="x86_64 arm64"
create_wrksrc=yes
depends="alsa-lib dbus gtk+3 libcups libdrm libXcomposite libXdamage
 libXext libXfixes libXrandr libxcb libxshmfence nss pango"
short_desc="Private, fast, and honest web browser (pre-compiled binaries)"
maintainer="Dev Halder <dev.hldr2010@gmail.com>"
license="GPL-3.0-or-later, BSD-3-Clause"
homepage="https://helium.computer/"
provides="helium-${version}_${revision}"
conflicts="helium"

case "$XBPS_TARGET_MACHINE" in
x86_64*)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
	checksum=4493d756b98afbe3fd7d45c0ec215c23f5a0551fae715586fe6ce3b2298b155c
	;;
arm64*)
	distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-arm64_linux.tar.xz"
	checksum=IGNORE
	;;
*)
	broken="Unsupported target architecture"
	;;
esac

do_install() {
	vmkdir opt/helium
	
	# Find and copy contents safely from whatever directory the tarball expanded into
	cp -r $(find . -maxdepth 2 -type d -name "helium*")/* ${DESTDIR}/opt/helium/

	# Fix executable permissions for the browser binary and sandbox
	chmod 0755 "${DESTDIR}/opt/helium/helium"
	chmod 4755 "${DESTDIR}/opt/helium/chrome-sandbox" 2>/dev/null || true

	# Symlink the binary to /usr/bin
	vmkdir usr/bin
	ln -s /opt/helium/helium "${DESTDIR}/usr/bin/helium"

	# Install the included upstream .desktop file
	vinstall ${DESTDIR}/opt/helium/helium.desktop 0644 usr/share/applications
}
